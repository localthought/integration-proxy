# OIDC application-login client credentials and endpoints.
APP_AUTH_CLIENT_ID=
APP_AUTH_CLIENT_SECRET=
APP_AUTH_AUTHORIZATION_URL=https://accounts.example/authorize
APP_AUTH_TOKEN_URL=https://accounts.example/token
APP_AUTH_USERINFO_URL=https://accounts.example/userinfo
APP_AUTH_LABEL=OIDC
# Optional HTTPS namespace of a trusted catalog provider-scoped identity whose
# string subject must remain compatible with legacy APP_AUTH bare-sub tenants.
APP_AUTH_IDENTITY_NAMESPACE=

# Public URL this server is reachable at (no trailing slash).
# The application-login provider redirect URI must be set to "${BASE_URL}/auth/callback".
BASE_URL=http://localhost:8080

# Port to listen on.
PORT=8080

# Secret used to encrypt/sign the session cookie. Any length is fine; it is
# stretched to a full key internally. If unset, a random key is generated at
# startup and sessions won't survive a restart.
SESSION_SECRET=

# Secret used to deterministically derive each signed-in user's per-identity
# "user secret" (shown on the home page). Must stay constant across restarts
# and instances, or previously issued user secrets stop verifying. Any
# length is fine, but treat it as a real secret.
SERVER_SECRET=

# PostgreSQL connection URL. Required: stores short-lived consumed OAuth
# states, replay nonces, and encrypted one-time credentials.
DATABASE_URL=postgres://postgres@localhost:5432/integration_proxy

# Base64url-encoded, random 32-byte key for versioned XChaCha20-Poly1305
# credential envelopes. Required. Generate one with, e.g.:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
ENCRYPTION_KEY=

# Where the client address of the per-network key-check limit comes from
# (0.3.0+): `none` (TCP peer), or `heroku`/`rightmost` (the right-most
# X-Forwarded-For entry). localthought.io on Heroku must set `heroku`, or every
# client shares the router's limit.
TRUST_FORWARDED_FOR=none
# Key checks per client network and platform per hour (default 20, 0 = off).
KEY_CHECK_LIMIT_PER_HOUR=20

# Spotify Web API uses PKCE; no client secret is needed. Its authorization
# server advertises only the public "none" client authentication method, so
# that must be set explicitly (the proxy otherwise defaults to
# client_secret_post, which requires a secret).
OAUTH_SPOTIFY_CLIENT_ID=
OAUTH_SPOTIFY_CLIENT_AUTH_METHOD=none

# Discord OAuth application; callback ${BASE_URL}/oauth/discord/callback
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
