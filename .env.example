# Google OAuth 2.0 credentials, from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL this server is reachable at (no trailing slash).
# The Google OAuth redirect URI must be set to "${BASE_URL}/auth/callback".
BASE_URL=http://localhost:8080

# Port to listen on.
PORT=8080

# Secret used to encrypt/sign the session cookie. Any length is fine; it is
# stretched to a full key internally. If unset, a random key is generated at
# startup and sessions won't survive a restart.
SESSION_SECRET=

# Secret used to deterministically derive each signed-in user's per-identity
# "user secret" (shown on the home page). Must stay constant across restarts
# and instances, or previously issued user secrets stop verifying. Any
# length is fine, but treat it as a real secret.
SERVER_SECRET=

# Spotify Web API uses PKCE; no client secret is needed.
OAUTH_SPOTIFY_CLIENT_ID=

# Discord OAuth application; callback ${BASE_URL}/oauth/discord/callback
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
